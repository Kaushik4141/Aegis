{
  "name": "api",
  "version": "0.1.0",
  "private": true,
  "main": "src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply sentinelgate-d1 --local",
    "db:migrate:remote": "wrangler d1 migrations apply sentinelgate-d1 --remote",
    "db:seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@hono/node-server": "^1.13.7",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.6.14",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.0.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.10.2",
    "better-sqlite3": "^13.0.3",
    "drizzle-kit": "^0.30.5",
    "tsx": "^4.23.15",
    "typescript": "^5.7.2",
    "wrangler": "^4.151.3"
  }
}

# Optional — without these, SentinelGate uses deterministic policy + in-memory storage.
JEV_API_KEY=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
SENTINEL_REDIS_NAMESPACE=local
# Comma-separated browser origin allowlist. Never use *; unset permits only local origins.
SENTINEL_CORS_ORIGIN=http://localhost:3000
# Optional admin bearer token for all control-plane routes. Keep this out of git.
SENTINEL_ADMIN_TOKEN=
# Public origin for exact MCP OAuth callbacks (for example https://gateway.example.com).
SENTINEL_PUBLIC_URL=http://localhost:3000
# Optional fallback when an MCP OAuth server does not support dynamic client registration.
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_CLIENT_NAME=SentinelGate MCP Gateway
SENTINEL_OAUTH_STATE_TTL_MS=600000
SENTINEL_STORE=sqlite
SENTINEL_DATA_DIR=./data
SENTINEL_BUCKET_ROOT=./data/s3-buckets
SENTINEL_REPO_ROOT=./data/acme-repo
GITHUB_TOKEN=
DD_API_KEY=
DD_APP_KEY=
JEV_API_URL=https://api.jevmodel.org/v1/decide

# Interactive terminal agent (set at least one provider key)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional: gemini, openai, or anthropic. Defaults to the first configured key.
AGENT_PROVIDER=
SENTINEL_GATEWAY_URL=http://localhost:3000/api/v1
SENTINEL_HITL_TIMEOUT_MS=120000
MCP_HITL_TIMEOUT_MS=120000
AGENT_HITL_TIMEOUT_MS=120000
# MCP proxy limits: request bodies are JSON objects and list limits are capped at 500.
# Per-connection tokens are generated by POST /api/v1/connections and returned once.

{
  "name": "sentinelgate",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@12.0.2",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:web": "turbo run dev --filter=web",
    "dev:api": "turbo run dev --filter=api",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "mcp:server": "tsx mcp-server/index.ts",
    "agent": "tsx scripts/real-agent.ts",
    "db:generate": "turbo run db:generate --filter=api",
    "db:migrate": "turbo run db:migrate --filter=api",
    "db:migrate:remote": "turbo run db:migrate:remote --filter=api",
    "db:seed": "turbo run db:seed --filter=api"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript": "^5.7.2",
    "wrangler": "^4.151.3"
  }
}
